# Neon pooled connection (host has -pooler). The app uses this.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# Neon direct connection. Prisma migrations use this.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_string

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Private folder for uploads (Phase 3)
UPLOAD_DIR=./private_uploads

# Password used ONLY by the seed script for the 4 demo users
SEED_PASSWORD=your_pass